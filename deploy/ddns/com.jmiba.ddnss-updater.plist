<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>jmiba.ddnss-updater</string>

	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>/Users/jmiba/Github/obsidian-webhooks-server/deploy/ddns/update-ddnss.sh</string>
	</array>

	<!-- Every 15 minutes. ddnss.de requires >= 5 min between updates. -->
	<key>StartInterval</key>
	<integer>900</integer>

	<key>RunAtLoad</key>
	<true/>

	<key>StandardOutPath</key>
	<string>/tmp/ddnss-updater.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/ddnss-updater.err.log</string>
</dict>
</plist>
